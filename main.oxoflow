expand_inputs = [
    { pattern = "results/{config.aligner}/mtx_conversions/{sample}/{sample}_raw_matrix.h5ad", variables = { sample = "config.samples_list" } }
]
output = ["results/{config.aligner}/mtx_conversions/combined_raw_matrix.h5ad"]
when = "config.skip_cellbender || config.aligner == 'cellrangerarc'"
shell = "python3 scripts/concat_h5ad.py --samplesheet {config.samplesheet} --input-type raw --output {output}"

log = "logs/concat_h5ad_raw.log"
[rules.resources]
