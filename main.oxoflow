# ---------------------------------------------------------------------------
# Collated software versions (upstream softwareVersionsToYAML + collectFile)
# The aligner-specific blocks are emitted only for the active aligner, like the
# upstream channel topic (which collates only the tools that actually ran).
# ---------------------------------------------------------------------------
[[rules]]
name = "collect_versions"
description = "Write the collated software-versions YAML consumed by MultiQC"
input = []
output = ["results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml"]
shell = """
mkdir -p results/pipeline_info
cat > results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml <<'EOF'
"FASTQC":
  fastqc: 0.12.1
"GUNZIP_FASTA":
  gunzip: 1.13
"GUNZIP_GTF":
  gunzip: 1.13
"GTF_GENE_FILTER":
  python: 3.9
"MTX_TO_H5AD":
  python: 3.12
  scanpy: 1.10.2
  pandas: 2.3.0
  anndata: 0.11.4
"CONCAT_H5AD":
  scanpy: 1.10.2
"ANNDATAR_CONVERT":
  anndataR: 1.0.2
  SeuratObject: 5.5.0
  SingleCellExperiment: 1.32.0
"MULTIQC":
  multiqc: 1.34
EOF
case "{config.aligner}" in
    cellranger)
        cat >> results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml <<'EOF'
"CELLRANGER_MKGTF":
  cellranger: 10.0.0
"CELLRANGER_MKREF":
  cellranger: 10.0.0
"CELLRANGER_COUNT":
  cellranger: 10.0.0
EOF
        ;;
    cellrangerarc)
        cat >> results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml <<'EOF'
"CELLRANGERARC_MKGTF":
  cellrangerarc: 2.0.2
"CELLRANGERARC_MKREF":
  cellrangerarc: 2.0.2
"CELLRANGERARC_COUNT":
  cellrangerarc: 2.0.2
EOF
        ;;
    simpleaf)
        cat >> results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml <<'EOF'
"SIMPLEAF_INDEX":
  alevin-fry: 0.11.2
  piscem: 0.12.2
  salmon: 1.10.3
  simpleaf: 0.19.5
"SIMPLEAF_QUANT":
  alevin-fry: 0.11.2
  piscem: 0.12.2
  salmon: 1.10.3
  simpleaf: 0.19.5
"QCATCH":
  qcatch: 0.2.12
EOF
        ;;
    kallisto)
        cat >> results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml <<'EOF'
"KALLISTOBUSTOOLS_REF":
  kallistobustools: 0.28.2
"KALLISTOBUSTOOLS_COUNT":
  kallistobustools: 0.28.2
EOF
        ;;
    star)
        cat >> results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml <<'EOF'
"STAR_GENOMEGENERATE":
  star: 2.7.11b
  samtools: 1.21
  gawk: 5.1.0
"STAR_GENOMEPARAMS_UPGRADE":
  gawk: 5.3.1
"STAR_ALIGN":
  star: 2.7.10b
EOF
        ;;
esac
if [ "{config.skip_cellbender}" != "true" ] && [ "{config.aligner}" != "cellrangerarc" ]; then
    cat >> results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml <<'EOF'
"CELLBENDER_REMOVEBACKGROUND":
  cellbender: 0.3.2
"ANNDATA_BARCODES":
  python: 3.12
  anndata: 0.11.4
  pandas: 2.3.0
EOF
fi
"""

log = "logs/collect_versions.log"
[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/coreutils_grep_gzip_lbzip2_pruned:838ba80435a629f8"

# ---------------------------------------------------------------------------
# Reporting inputs for MultiQC (upstream paramsSummaryMultiqc + methodsDescriptionText)
# ---------------------------------------------------------------------------
[[rules]]
name = "workflow_summary"
description = "Write the workflow-summary YAML consumed by MultiQC (upstream paramsSummaryMultiqc)"
input = []
output = ["results/pipeline_info/workflow_summary_mqc.yaml"]
shell = """
mkdir -p results/pipeline_info
cat > results/pipeline_info/workflow_summary_mqc.yaml <<'EOF'
id: "nf-core-scrnaseq-summary"
description: " - this information is collected when the pipeline is started."
section_name: "nf-core/scrnaseq Workflow Summary"
section_href: "https://github.com/nf-core/scrnaseq"
plot_type: "html"
data: |
    <dl class="dl-horizontal">
        <dt>nf-core/scrnaseq</dt><dd><em>v4.2.0</em></dd>
        <dt>oxo-flow-scrnaseq port</dt><dd><em>v1.0.0</em></dd>
        <dt>Aligner</dt><dd><code>{config.aligner}</code></dd>
        <dt>Protocol</dt><dd><code>{config.protocol}</code></dd>
        <dt>Expected cells</dt><dd><code>{config.expected_cells}</code></dd>
        <dt>Save aligner intermediate files</dt><dd><code>{config.save_align_intermeds}</code></dd>
        <dt>Skip FastQC</dt><dd><code>{config.skip_fastqc}</code></dd>
        <dt>Skip CellBender</dt><dd><code>{config.skip_cellbender}</code></dd>
        <dt>Skip QCatch</dt><dd><code>{config.skip_qcatch}</code></dd>
        <dt>Skip MultiQC</dt><dd><code>{config.skip_multiqc}</code></dd>
        <dt>Samplesheet</dt><dd><code>{config.samplesheet}</code></dd>
        <dt>FASTA</dt><dd><code>{config.fasta}</code></dd>
        <dt>GTF</dt><dd><code>{config.gtf}</code></dd>
        <dt>Barcode whitelist</dt><dd><code>{config.whitelist}</code></dd>
        <dt>kb workflow</dt><dd><code>{config.kb_workflow}</code></dd>
        <dt>STAR features</dt><dd><code>{config.star_feature}</code></dd>
        <dt>simpleaf UMI resolution</dt><dd><code>{config.simpleaf_umi_resolution}</code></dd>
        <dt>Remove doublets (QCatch)</dt><dd><code>{config.remove_doublets}</code></dd>
        <dt>MultiQC title</dt><dd><code>{config.multiqc_title}</code></dd>
    </dl>
EOF
"""

log = "logs/workflow_summary.log"
[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/multiqc:1.34--db7c73dae76bc9e6"

[[rules]]
name = "methods_description"
description = "Render the methods-description YAML consumed by MultiQC (upstream methodsDescriptionText)"
input = ["assets/methods_description_template.yml"]
output = ["results/pipeline_info/methods_description_mqc.yaml"]
shell = """
mkdir -p results/pipeline_info
# upstream methodsDescriptionText fills the ${...} placeholders of the template
# (braces are built via chr() so the engine's wildcard scanner never sees them)
python3 - <<'PYEOF'
import pathlib

b = chr(123)
e = chr(125)

def ph(name):
    return "$" + b + name + e

template = pathlib.Path("{input}").read_text()
subs = [
    (ph("workflow.manifest.version"), "1.0.0"),
    ("Nextflow v" + ph("workflow.nextflow.version"), "oxo-flow v0.15.0"),
    (ph("workflow.commandLine"), "oxo-flow run main.oxoflow"),
    (ph("doi_text"), " "),
    (ph("tool_citations"), "Tools used in the workflow included: FastQC (Andrews 2010), Cell Ranger (Zheng et al. 2017), STAR (Dobin et al. 2013), simpleaf, alevin-fry (He et al. 2024), kallisto|bustools (Bray et al. 2016; Melsted et al. 2021), CellBender (Fleming et al. 2023), scanpy (Wolf et al. 2018), MultiQC (Ewels et al. 2016)."),
    (ph("tool_bibliography"), ""),
    (ph("nodoi_text"), ""),
]
for key, value in subs:
    template = template.replace(key, value)
pathlib.Path("{output}").write_text(template)
PYEOF
"""

log = "logs/methods_description.log"
[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/multiqc:1.34--db7c73dae76bc9e6"

# ---------------------------------------------------------------------------
# MULTIQC: aggregate report (upstream MULTIQC)
# The union of per-aligner expand_inputs patterns: only the active aligner's
# files exist, mirroring the upstream ch_multiqc_files channel mixing.
# ---------------------------------------------------------------------------
[[rules]]
name = "multiqc"
description = "MultiQC aggregation of FastQC, aligner web summaries/logs and collated versions"
input = []
expand_inputs = [
    { pattern = "results/fastqc/{sample}_1_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "results/fastqc/{sample}_1_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "results/fastqc/{sample}_2_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "results/fastqc/{sample}_2_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "results/{config.aligner}/count/{sample}/outs/web_summary.html", variables = { sample = "config.samples_list" } },
    { pattern = "results/simpleaf/{sample}/simpleaf_quant/af_quant/alevin/quants.h5ad", variables = { sample = "config.samples_list" } },
    { pattern = "results/star/{sample}/{sample}.Log.final.out", variables = { sample = "config.samples_list" } },
]
output = ["results/multiqc/multiqc_report.html", "results/multiqc/multiqc_data"]
depends_on = ["collect_versions", "workflow_summary", "methods_description", "cellranger_count", "cellrangerarc_count", "simpleaf_quant", "star_align"]
when = "!config.skip_multiqc"
shell = """
# stage inputs flat like the nf-core MULTIQC module (stageAs '?/*')
for f in {input}; do
    [ -e "$f" ] && cp -r "$f" .
done
cp results/pipeline_info/nf_core_scrnaseq_software_mqc_versions.yml results/pipeline_info/workflow_summary_mqc.yaml results/pipeline_info/methods_description_mqc.yaml .
# upstream ext.args: --title when multiqc_title is set
if [ -n "{config.multiqc_title}" ]; then TITLE_ARG="--title {config.multiqc_title}"; else TITLE_ARG=""; fi
multiqc --force $TITLE_ARG --config {config.multiqc_config} .
# fresh-dir semantics: a resumed run keeps the previous results/ tree
# and mv refuses to merge into a non-empty dir (live: "cannot overwrite
# 'results/multiqc/multiqc_data': Directory not empty")
rm -rf results/multiqc
mkdir -p results/multiqc
mv multiqc_report.html multiqc_data results/multiqc/
"""

log = "logs/multiqc.log"
[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/multiqc:1.34--db7c73dae76bc9e6"
